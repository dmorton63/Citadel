{
    "desktop": {
        "theme": {
            "base": "Vista",
            "overrides": {
                "palette": {
                    "accent": "#4A90E2",
                    "accentLight": "#6BB6FF",
                    "accentDark": "#2F5A8A",
                    "text": "#FFFFFF",
                    "textSecondary": "#CCCCCC",
                    "panel": "#202020",
                    "panelBorder": "#303030"
                },
                "metrics": {
                    "cornerRadius": 6,
                    "buttonCornerRadius": 6,
                    "borderWidth": 1
                },
                "button": {
                    "sidebar": {
                        "fillNormal": "#661A1A1A",
                        "fillHover": "#882A2A2A",
                        "fillPressed": "#992A2A2A",
                        "text": "#FFFFFF",
                        "border": "#80303030",
                        "shineIntensity": 0.25,
                        "glass": true
                    },
                    "button": { "type": "button", "id": "btn3D", "text": "3D", "action": "view3d", "x": 20, "y": 220, "w": 160, "h": 32 },
                    "accent": {
                        "fillNormal": "#883f3f47",
                        "fillHover": "#AA6BB6FF",
                        "fillPressed": "#AA2F5A8A",
                        "text": "#FFFFFF",
                        "border": "#80303030",
                        "shineIntensity": 0.35,
                        "glass": true
                    },
                    "destructive": {
                        "fillNormal": "#AAC84040",
                        "fillHover": "#BBD85A5A",
                        "fillPressed": "#BBA03030",
                        "text": "#FFFFFF",
                        "border": "#A0802020",
                        "glass": true
                    }
                },
                "font": {
                    "family": "OpenSans",
                    "size": 16
                }
            }
        },
        "layout": {
            "type": "absolute",
            "controls": [
                {
                    "id": "headerBar",
                    "type": "panel",
                    "x": 0,
                    "y": 0,
                    "width": "100%",
                    "height": 56,
                    "background": "#80181818",
                    "borderBottom": "#80303030",
                    "children": [
                        {
                            "id": "headerTitle",
                            "type": "label",
                            "text": "CITADEL Desktop",
                            "x": 20,
                            "y": 16,
                            "color": "#FFFFFF",
                            "font": "system-bold-18"
                        },
                        {
                            "id": "clockLabel",
                            "type": "label",
                            "text": "12:45 PM",
                            "x": "right-100",
                            "y": 18,
                            "color": "#CCCCCC",
                            "font": "system-regular-16"
                        }
                    ]
                },
                {
                    "id": "sidebar",
                    "type": "panel",
                    "x": 0,
                    "y": 56,
                    "width": 200,
                    "height": "100%-56",
                    "background": "#801A1A1A",
                    "borderRight": "#80303030",
                    "children": [
                        {
                            "id": "sidebarTitle",
                            "type": "label",
                            "text": "Applications",
                            "x": 20,
                            "y": 20,
                            "color": "#AAAAAA",
                            "font": "system-bold-14"
                        },
                        {
                            "id": "btnFiles",
                            "type": "button",
                            "text": "File Manager",
                            "x": 20,
                            "y": 60,
                            "width": 160,
                            "height": 32,
                            "role": "sidebar",
                            "icon": "/system/icons/folder.png"
                        },
                        {
                            "id": "btnSettings",
                            "type": "button",
                            "text": "Settings",
                            "x": 20,
                            "y": 100,
                            "width": 160,
                            "height": 32,
                            "role": "sidebar",
                            "icon": "/system/icons/settings.png"
                        },
                        {
                            "id": "btnTerminal",
                            "type": "button",
                            "text": "Terminal",
                            "x": 20,
                            "y": 140,
                            "width": 160,
                            "height": 32,
                            "role": "sidebar",
                            "icon": "/system/icons/terminal.png"
                        },
                        {
                            "id": "btnCMMS",
                            "type": "button",
                            "text": "CMMS",
                            "action": "cmms",
                            "x": 20,
                            "y": 180,
                            "width": 160,
                            "height": 32,
                            "role": "sidebar",
                            "icon": "/system/icons/settings.png"
                        }
                    ]
                },
                {
                    "id": "mainContent",
                    "type": "panel",
                    "x": 200,
                    "y": 56,
                    "width": "100%-200",
                    "height": "100%-56",
                    "background": "#22181818",
                    "children": [
                        {
                            "id": "welcomeLabel",
                            "type": "label",
                            "text": "Welcome to CITADEL!",
                            "x": 40,
                            "y": 40,
                            "color": "#FFFFFF",
                            "font": "system-bold-28"
                        },
                        {
                            "id": "infoLabel",
                            "type": "label",
                            "text": "Your theme and wallpaper can change with the season.",
                            "x": 40,
                            "y": 90,
                            "color": "#CCCCCC",
                            "font": "system-regular-16"
                        },
                        {
                            "id": "cardPanel",
                            "type": "panel",
                            "x": 40,
                            "y": 150,
                            "width": 420,
                            "height": 220,
                            "background": "#662A2A2A",
                            "border": "#80404040",
                            "children": [
                                {
                                    "id": "cardText",
                                    "type": "label",
                                    "text": "Kernel: CITADEL OS Experimental\nRenderer: PainterSurface\nDesktop: JSON-driven",
                                    "x": 170,
                                    "y": 40,
                                    "color": "#CCCCCC",
                                    "font": "system-regular-14"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "taskbar",
                    "type": "panel",
                    "x": 0,
                    "y": "bottom-48",
                    "width": "100%",
                    "height": 48,
                    "background": "#80181818",
                    "borderTop": "#80303030",
                    "children": [
                        {
                            "id": "startButton",
                            "type": "button",
                            "text": "Start",
                            "x": 10,
                            "y": 9,
                            "width": 100,
                            "height": 30,
                            "role": "accent",
                            "icon": "/system/icons/start.png"
                        },
                        {
                            "id": "shutDownButton",
                            "type": "button",
                            "text": "Shut Down",
                            "x": 120,
                            "y": 9,
                            "width": 100,
                            "height": 30,
                            "role": "destructive",
                            "icon": "/system/icons/shutdown.png"
                        },
                        {
                            "id": "taskbarClock",
                            "type": "label",
                            "text": "12:45 PM",
                            "x": "right-80",
                            "y": 14,
                            "color": "#CCCCCC",
                            "font": "system-regular-16"
                        }
                    ]
                }
            ]
        }
    }
}