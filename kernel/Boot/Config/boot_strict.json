{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QAIOS Boot Configuration",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "profile",
    "min_spec",
    "security",
    "paths"
  ],

  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },

    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },

    "min_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ram_mib_required", "cpu", "tpm"],
      "properties": {
        "ram_mib_required": {
          "type": "integer",
          "minimum": 1
        },

        "cpu": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "require_64bit",
            "require_sse2",
            "require_nx",
            "require_longmode"
          ],
          "properties": {
            "require_64bit": { "type": "boolean" },
            "require_sse2": { "type": "boolean" },
            "require_nx": { "type": "boolean" },
            "require_longmode": { "type": "boolean" }
          }
        },

        "tpm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "minimum_version"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["required", "optional", "disabled"]
            },
            "minimum_version": {
              "type": "number",
              "minimum": 1.0
            }
          }
        }
      }
    },

    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_signature",
        "require_measurement",
        "golden",
        "production"
      ],
      "properties": {
        "require_signature": { "type": "boolean" },
        "require_measurement": { "type": "boolean" },

        "golden": {
          "type": "object",
          "additionalProperties": false,
          "required": ["signed", "measured"],
          "properties": {
            "signed": { "type": "boolean" },
            "measured": { "type": "boolean" }
          }
        },

        "production": {
          "type": "object",
          "additionalProperties": false,
          "required": ["signed", "measured"],
          "properties": {
            "signed": { "type": "boolean" },
            "measured": { "type": "boolean" }
          }
        }
      }
    },

    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "golden_config",
        "production_config",
        "registry_personality",
        "registry_overrides_dir"
      ],
      "properties": {
        "golden_config": {
          "type": "string",
          "minLength": 1
        },
        "production_config": {
          "type": "string",
          "minLength": 1
        },
        "registry_personality": {
          "type": "string",
          "minLength": 1
        },
        "registry_overrides_dir": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}