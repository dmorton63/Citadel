<Desktop>
    <Background type="image"
           path="/system/wall/CHRISTMAS.PNG"
           mode="stretch" />
    <Theme accent="#C62828"
           accentLight="#FF8A80"
           accentDark="#8E0000"
           text="#FFFFFF"
           textSecondary="#FFEDE0"
           panel="#2B1A1A"
           panelBorder="#3D2626"></Theme>
    <Layout type="absolute">
        !-- HEADER BAR -->
        <Panel id="headerBar"
               x="0"
               y="0"
               width="100%"
               height="56"
               background="#8E0000"
               borderBottom="#5A0A0A">
            <Label id="headerTitle"
                   text="CITADEL Christmas Desktop"
                   x="20"
                   y="16"
                   color="#FFEDE0"
                   font="system-bold-18"
                   width="331"
                   height="32" />
            <Label id="headerIcon"
                   text="🎄"
                   x="right-160"
                   y="14"
                   color="#FFFFFF"
                   font="system-bold-24" />
            <Label id="clockLabel"
                   text="12:45 PM"
                   x="right-100"
                   y="18"
                   color="#FFEDE0"
                   font="system-regular-16" />
        </Panel>
        !-- SIDEBAR -->
        <Panel id="sidebar"
               x="0"
               y="56"
               width="200"
               height="100%-56"
               background="#2B1A1A"
               borderRight="#3D2626">
            <Label id="sidebarTitle"
                   text="Applications"
                   x="20"
                   y="20"
                   color="#FFD6C2"
                   font="system-bold-14" />
            <Button id="btnFiles"
                   text="File Manager"
                   x="20"
                   y="60"
                   width="160"
                   height="32"
                   role="sidebar"
                   icon="/system/icons/folder.png" />
            <Button id="btnSettings"
                   text="Settings"
                   x="20"
                   y="100"
                   width="160"
                   height="32"
                   role="sidebar"
                   icon="/system/icons/settings.png" />
            <Button id="btnTerminal"
                   text="Terminal"
                   x="20"
                   y="140"
                   width="160"
                   height="32"
                   role="sidebar"
                   icon="/system/icons/terminal.png" />
            <Button id="btnChristmasNotes"
                   text="Christmas Notes"
                   x="20"
                   y="180"
                   width="160"
                   height="32"
                   role="sidebar"
                   icon="/system/icons/christmas.png" />
        </Panel>
        !-- MAIN CONTENT -->
        <Panel id="mainContent"
               x="202"
               y="53"
               width="100%-200"
               height="100%-56"
               background="rgba(255,240,240,0.18)">
            <Label id="welcomeLabel"
                   text="Welcome to Christmas in CITADEL"
                   x="40"
                   y="40"
                   color="#5A0A0A"
                   font="system-bold-28"
                   width="621"
                   height="32" />
            <Label id="infoLabel"
                   text="Warm lights, festive colors, and a joyful workspace."
                   x="43"
                   y="90"
                   color="#FF0000"
                   font="system-regular-16"
                   width="515"
                   height="32" />
            <Panel id="cardPanel"
                   x="40"
                   y="150"
                   width="420"
                   height="220"
                   background="#FFEDE0"
                   border="#D9A38A">
                <Label id="cardTitle"
                       text="System Information"
                       x="20"
                       y="20"
                       color="#5A0A0A"
                       font="system-bold-18"
                       width="316"
                       height="32" />
                <Label id="cardText"
                       text="Kernel: QAIOSPLUSV1 Experimental\nTheme: Christmas 2026\nRenderer: PainterSurface\nSeasonal Mode: Holiday"
                       x="20"
                       y="60"
                       color="#8E0000"
                       font="system-regular-14"
                       width="382"
                       height="32" />
            </Panel>
        </Panel>
        !-- TASKBAR -->
        <Panel id="taskbar"
               x="0"
               y="bottom-48"
               width="100%"
               height="48"
               background="#8E0000"
               borderTop="#5A0A0A">
            <Button id="startButton"
                   text="🎅 Start"
                   x="10"
                   y="9"
                   width="100"
                   height="30"
                   role="accent"
                   icon="/system/icons/christmas.png" />
            <Button id="shutDownButton"
                   text="Shut Down"
                   x="120"
                   y="9"
                   width="100"
                   height="30"
                   role="destructive"
                   icon="/system/icons/shutdown.png" />
            <Label id="taskbarClock"
                   text="12:45 PM"
                   x="right-80"
                   y="14"
                   color="#FFEDE0"
                   font="system-regular-16" />
        </Panel>
    </Layout>
</Desktop>